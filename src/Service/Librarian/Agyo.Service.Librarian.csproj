<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Agyo.Service.Librarian — a runnable code/docs intelligence service ("local-first Context7"),
    re-homed from Koan's Koan.Service.KoanContext (AGYO-0002). This is an APP you run, not a
    Sylin.Agyo.* library you reference: OutputType=Exe, IsPackable=false. It depends only on
    Koan's PUBLIC packages (Sylin.Koan.*) and sibling Agyo libraries (Sylin.Agyo.*) — never a
    path back into the Koan repo (STACK-0001 layering law).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Agyo.Service.Librarian</RootNamespace>
    <AssemblyName>Agyo.Service.Librarian</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include MCP SDK files (non-standard location) -->
    <Content Include="mcp-sdk\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Third-party (carried over unchanged) -->
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="Polly" Version="8.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Koan public packages (resolved from local-feed; versions per the feed) -->
    <PackageReference Include="Sylin.Koan.Core" Version="0.17.3" />
    <PackageReference Include="Sylin.Koan.Data.Core" Version="0.17.1" />
    <PackageReference Include="Sylin.Koan.Data.Connector.Sqlite" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.Web" Version="0.17.4" />
    <PackageReference Include="Sylin.Koan.Web.Sse" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.Web.Connector.Swagger" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.Mcp" Version="0.17.4" />
    <PackageReference Include="Sylin.Koan.AI" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.AI.Contracts" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.AI.Connector.Ollama" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.Data.Vector" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.Data.Vector.Connector.Weaviate" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.Orchestration.Aspire" Version="0.17.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sibling Agyo library: the scheduled JobMaintenanceTask (was Koan.Scheduling, migrated to agyo) -->
    <ProjectReference Include="..\..\Scheduling\Agyo.Scheduling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude wwwroot from dotnet watch (UI changes don't restart backend) -->
    <Watch Remove="wwwroot\**\*" />
  </ItemGroup>

</Project>
