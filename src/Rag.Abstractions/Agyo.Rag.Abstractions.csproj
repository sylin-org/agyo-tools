<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Agyo RAG contracts: corpus abstractions, concept graph store, query/ingest options, and result types — the shared surface for the Agyo RAG stack over Koan's public packages.</Description>
    <PackageTags>$(CommonPackageTags);ai;rag;corpus;retrieval;contracts</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Sylin.Koan.Data.Abstractions" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.AI.Contracts" Version="0.17.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.8" />
  </ItemGroup>
</Project>
