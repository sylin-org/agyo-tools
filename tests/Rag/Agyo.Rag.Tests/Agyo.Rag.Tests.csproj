<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ARCH-0079 integration specs for the Agyo.Rag capability.
    Boot-smoke boots a REAL AddKoan() host (genuine reflective discovery) and asserts the
    RAG service surface resolves. The behavioral ingest-then-query spec is container-gated
    (skip-clean) on AI infra via Xunit.SkippableFact + InfraProbe.
    Inherits tests/Directory.Build.props (TreatWarningsAsErrors, bin/obj redirect, IsPackable=false).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
  </ItemGroup>

  <!-- Data adapter so RAG's job ledger + Entity<T> persistence resolve under AddKoan(). -->
  <ItemGroup>
    <PackageReference Include="Sylin.Koan.Data.Connector.InMemory" Version="0.17.0" />
  </ItemGroup>

  <!-- AI + Vector connectors for the container-gated behavioral ingest-then-query spec. -->
  <ItemGroup>
    <PackageReference Include="Sylin.Koan.AI.Connector.Ollama" Version="0.17.0" />
    <PackageReference Include="Sylin.Koan.Data.Vector.Connector.Qdrant" Version="0.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Agyo.Testing\Agyo.Testing.csproj" />
    <ProjectReference Include="..\..\..\src\Rag\Agyo.Rag.csproj" />
  </ItemGroup>
</Project>
